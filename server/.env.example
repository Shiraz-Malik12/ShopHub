# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets or credentials.

PORT=5000
NODE_ENV=development

# Local MongoDB by default. For Atlas, use something like:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shophub
MONGODB_URI=mongodb://127.0.0.1:27017/shophub

# Must match the frontend's dev URL — used for CORS and cookie scoping.
CLIENT_URL=http://localhost:5173

# Long random strings. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-string
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Gmail SMTP for sending OTP emails.
# 1. Enable 2-Step Verification on the Gmail account.
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Use the Gmail address as SMTP_USER and the 16-character App Password
#    (no spaces) as SMTP_PASS — NOT your normal Gmail login password.
# Leave SMTP_USER/SMTP_PASS blank to use the dev fallback that logs the
# OTP to the server console instead of emailing it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ShopHub <no-reply@shophub.local>
