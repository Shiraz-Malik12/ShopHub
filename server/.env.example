# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets or credentials.

PORT=5000
# development | production. In production the server refuses to start unless
# the secrets are strong and Cloudinary + email are configured (see
# src/config/env.js), and it also serves the built website from ../dist.
NODE_ENV=development

# Set to 1 when the server runs behind ONE proxy/load balancer (Render,
# Railway, Heroku, Nginx...), so rate limits see each visitor's real address.
# Leave empty when running directly (e.g. on your own computer).
TRUST_PROXY=

# Local MongoDB by default. For Atlas, use something like:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shophub
MONGODB_URI=mongodb://127.0.0.1:27017/shophub

# The address customers use to open the shop. Used for CORS and for links
# inside emails. Development: http://localhost:5173. Production: your real
# https:// address (e.g. https://shophub.example.com).
CLIENT_URL=http://localhost:5173

# Long random strings (at least 32 characters; production refuses shorter
# ones), different from each other. Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-string
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Gmail SMTP for sending OTP emails.
# 1. Enable 2-Step Verification on the Gmail account.
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Use the Gmail address as SMTP_USER and the 16-character App Password
#    (no spaces) as SMTP_PASS — NOT your normal Gmail login password.
# Leave SMTP_USER/SMTP_PASS blank to use the dev fallback that prints emails
# (OTP codes, order emails) to the server console instead of sending them.
# Required in production.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ShopHub <no-reply@shophub.local>

# Only read by `npm run seed:admin` (server/src/scripts/seedAdmin.js) — not
# used by the running API. Creates this account as role: admin if it
# doesn't exist yet, or promotes it in place if it already does.
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary — permanent storage for product images. Find all three on
# your Cloudinary dashboard (https://console.cloudinary.com). The API
# secret must stay server-side only; never put it in the frontend.
# Optional in development (images are saved to server/uploads instead);
# required in production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
